	"scripts": {
		"build": "nest build",
		"dev": "nest start --watch",
		"format": "prettier --write .",
		"start": "nest start",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint --max-warnings 0",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:e2e": "vitest run --config ./test/vitest-e2e.config.ts",
		"db:cli": "NODE_OPTIONS=\"-r tsconfig-paths/register\" typeorm-ts-node-commonjs -d typeorm-cli.datasource.ts",
		"db:migrate": "npm run db:cli -- migration:run",
		"db:migrate:revert": "npm run db:cli -- migration:revert",
		"db:migrate:show": "npm run db:cli -- migration:show",
		"db:generate": "npm run db:cli -- migration:generate",
		"db:schema:log": "npm run db:cli -- schema:log",
		"db:schema:sync": "npm run db:cli -- schema:sync",
		"test:integration": "vitest run --config ./test/vitest-integration.config.ts"
	},
