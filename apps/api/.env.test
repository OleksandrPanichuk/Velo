NODE_ENV=test
WEB_URL=http://localhost:3000
BASE_URL=http://localhost:8081

# Database — test container (port 5433 to avoid conflict with dev on 5432)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=velo_test

# JWT — short, deterministic secrets for tests
JWT_ACCESS_SECRET=test-access-secret-for-testing-only-x
JWT_REFRESH_SECRET=test-refresh-secret-for-testing-only-y
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# Redis — test container (port 6380)
REDIS_HOST=localhost
REDIS_PORT=6380

# Cache
CACHE_KEY_PREFIX=velo_cache_test
CACHE_DEFAULT_TTL=60000
CACHE_L1_TTL_MS=10000
CACHE_L1_LRU_SIZE=500

# S3 / MinIO — test container (port 9010)
AWS_S3_ENDPOINT=http://localhost:9010
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY=minio
AWS_S3_SECRET_ACCESS_KEY=minio123456
AWS_S3_BUCKET_NAME=velo-test
AWS_S3_FORCE_PATH_STYLE=true

# SMTP — mocked in tests; values here satisfy env validation only
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Velo Test" <no-reply@velo.test>
SMTP_SECURE=false

# OAuth — fake credentials; OAuth redirects are not tested
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8081/api/auth/google/callback
GITHUB_CLIENT_ID=test-github-client-id
GITHUB_CLIENT_SECRET=test-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:8081/api/auth/github/callback
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/oauth/success
OAUTH_FAILURE_REDIRECT=http://localhost:3000/oauth/failure

# Client URLs
CLIENT_EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
CLIENT_RESET_PASSWORD_URL=http://localhost:3000/reset-password
