{
  "name": "e2e",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "infra:up": "docker compose -f ../../compose-files/docker-compose.e2e.yml up -d --wait",
    "infra:down": "docker compose -f ../../compose-files/docker-compose.e2e.yml down -v"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "typescript": "^5"
  }
}
