{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@web/*": ["../web/src/*"]
    }
  },
  "include": ["**/*.ts", "../web/src/**/*.harness.ts"],
  "exclude": ["node_modules"]
}
