{
  "name": "velo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "eslint --fix \"**/*.{ts,tsx,js,mjs}\"",
    "check-types": "turbo run check-types",
    "codegen": "turbo run codegen",
    "test:e2e": "turbo run test:e2e --filter=e2e",
    "test:e2e:ui": "turbo run test:e2e:ui --filter=e2e",
    "test:e2e:report": "turbo run test:e2e:report --filter=e2e",
    "test:e2e:infra:up": "docker compose -f compose-files/docker-compose.e2e.yml up -d --wait",
    "test:e2e:infra:down": "docker compose -f compose-files/docker-compose.e2e.yml down -v"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
